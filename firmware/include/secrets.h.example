// Copy this file to secrets.h (gitignored) and fill in every value.
// Never commit secrets.h.
#pragma once

// The ESP32 supports 2.4 GHz networks only.
#define WIFI_SSID "your-2.4GHz-network"
#define WIFI_PASSWORD "your-wifi-password"

// The computer running Docker: its LAN IP (reserve it in the router) and the
// API's published port from docker-compose.yml. Find the IP with
// `ipconfig getifaddr en0` on macOS.
#define API_BASE_URL "http://192.168.1.50:5001"

// Same value as API_TOKEN in the server's .env.
#define API_TOKEN "replace-me"
